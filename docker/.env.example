# ─── Database ─────────────────────────────────────────────────────────────────
# Strong password for the postgres superuser. Change this before first run.
POSTGRES_PASSWORD=change-me-before-first-run

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret used to sign API tokens. Must be at least 32 characters.
# Generate with: openssl rand -base64 40
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Anon/publishable key — JWT signed with JWT_SECRET, role=anon.
# The value below is the standard Supabase dev token (matches the JWT_SECRET above).
# Generate your own at: https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd6Du7vie4M9GChWeda0dGo9cL8qDY6o

# Service role key — JWT signed with JWT_SECRET, role=service_role.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ─── Realtime ─────────────────────────────────────────────────────────────────
# Phoenix secret key base. Generate with: openssl rand -base64 64
SECRET_KEY_BASE=your-64-char-secret-key-base-for-realtime-service-here-xxxxxxxx

# ─── App ──────────────────────────────────────────────────────────────────────
# LAN IP or hostname of the machine running docker compose.
# Used so the QR code on /setup links to the right address.
# Example: 192.168.1.42 or mynas.local
HOST_IP=192.168.1.100
